# ============================================================
# 错题本 · 费曼融合 MVP —— 环境变量示例（技术说明 §2.4）
# 用法：复制为 .env 后填入密钥；.env 已在 .gitignore 中，切勿提交
# 密钥只允许存在于此文件对应的 .env 与服务端运行时内存中
# ============================================================

# ---------- 服务端自身 ----------
PORT=8787
HOST=127.0.0.1
# 数据目录（相对 app/），存放上传原图、任务、确认结果
DATA_DIR=data
# JWT 签名密钥，生产环境必须替换为随机串
JWT_SECRET=

# auto：三把模型密钥齐全则走真实模型，否则自动降级为演示样本
# mock：强制演示样本    live：强制真实模型
PROVIDER_MODE=auto

# 单次模型调用超时（秒）
LLM_TIMEOUT_SEC=120
# 真题/考试原卷是否禁止送往生成式模型：block | allow
MODEL_EXAM_POLICY=block

# ---------- 硅基流动（OCR / 推理）----------
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_KEY_ASR=
SILICONFLOW_KEY_OCR=
SILICONFLOW_KEY_DEEPSEEK=

# ---------- 智谱（手写视觉通道）----------
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_KEY_GLM=

# ---------- 模型名 ----------
MODEL_OCR=PaddlePaddle/PaddleOCR-VL-1.5
MODEL_GLM=GLM-5.3-Flash
MODEL_DEEPSEEK=deepseek-ai/DeepSeek-V4.1-Flash
MODEL_ASR=XingChenAGI/XingChenASR-V3.2-Ultra

# ---------- 检索参数（本轮只用到轮次上限的占位）----------
RETRIEVE_MAX_ROUNDS=2
